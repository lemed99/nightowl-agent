<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="System">
            <directory>tests/System</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The System harness subprocess reads this to choose the storage
             family, and tests/System/Concerns/ReadsRawFamily reads the same
             variable so the assertions follow it. Pinned to the production
             default so a bare local run exercises the format that ships; CI
             runs the v1 leg too (`NIGHTOWL_STORAGE_V2=false`), because v1 is
             still live for un-migrated tenants and as the kill switch.

             The pin is not redundant with that default: unset would ALSO mean
             v2, but stating it keeps the two readers provably in step.
             Integration tests are unaffected — they pin the family per
             RecordWriter constructor. -->
        <env name="NIGHTOWL_STORAGE_V2" value="true"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
