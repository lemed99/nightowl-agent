<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="System">
            <directory>tests/System</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The System harness subprocess reads this to choose the storage
             family; the legacy System assertions target the v1 tables. Run
             `NIGHTOWL_STORAGE_V2=true vendor/bin/phpunit -testsuite System`
             for a v2-mode pass (Phase F wiring runs both). Integration tests
             are unaffected: they pin the family per RecordWriter constructor. -->
        <env name="NIGHTOWL_STORAGE_V2" value="false"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
